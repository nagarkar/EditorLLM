{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "rootDir": "client",
    "outDir": "dist_client",
    "strict": false,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["client/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist_client", "src", "client/__tests__"]
}
